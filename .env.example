# Copy this to .env and edit if you need to override defaults.
# Docker Compose loads .env automatically.

# Host port the API is exposed on. The API binds to loopback only.
# Change this if 8000 conflicts with something else on your machine.
API_PORT=8000

# ---- Tile cache ----
# The API proxies and caches OSM tiles. By default it points at the
# main OSM tile servers; override below if you want a different
# upstream (e.g. a self-hosted tileserver-gl, MapTiler, etc.).
#
# OSM tile usage policy REQUIRES that you identify your application
# in the User-Agent header. Edit TILE_USER_AGENT to include a real
# contact URL or email.
#
#TILE_UPSTREAM_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#TILE_USER_AGENT=location-history/0.1 (+https://your-contact-here.example)
#TILE_RATE_PER_SEC=5
#TILE_BURST=20
